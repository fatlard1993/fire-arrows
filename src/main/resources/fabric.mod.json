{
	"schemaVersion": 1,
	"id": "fire-arrows-justfatlard",
	"version": "${version}",
	"name": "Fire Arrows",
	"description": "Torch arrows that set a torch where they land, fire arrows that set things alight and light TNT, and explosive arrows with a block of TNT on the tip.",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/fire-arrows"
	},
	"license": "MIT",
	"icon": "assets/fire-arrows-justfatlard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.fire_arrows.Main"
		]
	},
	"mixins": [
		"fire-arrows-justfatlard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"fletch_craft": "*"
	}
}
